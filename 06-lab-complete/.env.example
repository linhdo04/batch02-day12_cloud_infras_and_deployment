# Copy to .env for local use. Never commit the real .env file.
HOST=0.0.0.0
PORT=8000
PUBLIC_PORT=8000
ENVIRONMENT=development
DEBUG=false

APP_NAME=Production AI Agent
APP_VERSION=1.0.0
ENABLE_DOCS=true

# The lab uses an offline mock when OPENAI_API_KEY is empty.
OPENAI_API_KEY=
LLM_MODEL=mock-llm

AGENT_API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=2592000
CONVERSATION_MAX_MESSAGES=40
ALLOWED_ORIGINS=http://localhost:3000
